# Wallet configuration. Every variable is optional and has a default.
#
# Where this file is read:
#   - Docker Compose: copy it to `.env` next to docker-compose.yml. Compose only uses PORT, TZ,
#     BIND_ADDRESS and the Telegram bot's TELEGRAM_BOT_TOKEN and APP_URL from it; the paths and HOST
#     are fixed in docker-compose.yml to match the /data volume.
#   - Without Docker (`npm start`): the app does not read .env files itself. Export the variables.
#   - systemd (deploy/wallet.service, deploy/wallet.user.service): the unit already sets the paths
#     and reads an optional env file after them (/etc/wallet.env, or ~/.config/wallet.env for the user
#     service). Put only the variables you want to change there (TZ, PORT, HOST, and the Telegram
#     bot's TELEGRAM_BOT_TOKEN and APP_URL), not a copy of this file: its
#     `DATABASE_PATH=./data/wallet.db` below would override the unit's and put the database in the
#     wrong place.
#
# No authentication: keep the app on a trusted network (LAN / VPN such as Tailscale), never on the open internet.

# --- Docker Compose and bare metal -------------------------------------------------------------
PORT=3400

# Time zone, as an IANA name. It decides what "today" is (there is no time zone in the app settings)
# and therefore when a month ends. A mistyped name silently means UTC. In Docker, set it here: the
# default is UTC, because most shells do not export TZ for Compose to pick up.
TZ=Europe/Rome

# --- Docker Compose only -----------------------------------------------------------------------
# Host address the port is published on (default: all interfaces).
# BIND_ADDRESS=127.0.0.1

# --- Without Docker only (docker-compose.yml sets these for the container) -----------------------
HOST=0.0.0.0
DATABASE_PATH=./data/wallet.db
# Where backups go (default: a `backups` folder next to the database file).
# BACKUP_DIR=./data/backups
# Directory with the built Angular app. In production it defaults to frontend/dist/frontend/browser.
# STATIC_DIR=

# --- Telegram bot (optional; README, "Telegram bot") -------------------------------------------
# The bot is off unless the token is set. Every variable below is commented out on purpose: a made-up
# token would not keep the bot off, it would start it and show "Telegram refused the bot token".
# The token is a secret: keep this file out of version control (.env is git-ignored) and out of
# copies where you do not want it. Chats with a bot are not end-to-end encrypted, so what you send it
# passes through Telegram's servers. One bot per Wallet: a development copy needs its own token.
# The token from @BotFather (/newbot). Docker needs `docker compose up -d` after changing it.
# TELEGRAM_BOT_TOKEN=
# The address of the app as your phone reaches it. Optional: adds "Open" links to some bot messages.
# APP_URL=https://wallet.example.ts.net
# TELEGRAM_API_ROOT is for the tests only (a fake Telegram): do not set it.
