# Wallet configuration. Every variable is optional and has a default.
#
# Where this file is read:
#   - Docker Compose: copy it to `.env` next to docker-compose.yml. Compose only uses PORT, TZ and
#     BIND_ADDRESS from it; the paths and HOST are fixed in docker-compose.yml to match the /data volume.
#   - Without Docker (`npm start`): the app does not read .env files itself. Export the variables.
#   - systemd (deploy/wallet.service, deploy/wallet.user.service): the unit already sets the paths
#     and reads an optional env file after them. Put only the variables you want to change there
#     (TZ, PORT, HOST), not a copy of this file: its `DATABASE_PATH=./data/wallet.db` below would
#     override the unit's and put the database in the wrong place.
#
# No authentication: keep the app on a trusted network (LAN / VPN such as Tailscale), never on the open internet.

# --- Docker Compose and bare metal -------------------------------------------------------------
PORT=3400

# Time zone, as an IANA name. It decides what "today" is (there is no time zone in the app settings)
# and therefore when a month ends. A mistyped name silently means UTC. In Docker, set it here: the
# default is UTC, because most shells do not export TZ for Compose to pick up.
TZ=Europe/Rome

# --- Docker Compose only -----------------------------------------------------------------------
# Host address the port is published on (default: all interfaces).
# BIND_ADDRESS=127.0.0.1

# --- Without Docker only (docker-compose.yml sets these for the container) -----------------------
HOST=0.0.0.0
DATABASE_PATH=./data/wallet.db
# Where backups go (default: a `backups` folder next to the database file).
# BACKUP_DIR=./data/backups
# Directory with the built Angular app. In production it defaults to frontend/dist/frontend/browser.
# STATIC_DIR=
