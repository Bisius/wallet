{
  "name": "wallet",
  "version": "0.0.0",
  "private": true,
  "description": "Personal finance manager: salary, subscriptions, budgets and spendings",
  "workspaces": [
    "shared",
    "backend",
    "frontend",
    "e2e"
  ],
  "engines": {
    "node": "^22.22.3 || >=24.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c blue,magenta \"npm run dev -w @wallet/backend\" \"npm run start -w @wallet/frontend\"",
    "build": "npm run build -w @wallet/frontend && npm run build -w @wallet/backend",
    "start": "npm run start -w @wallet/backend",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "e2e": "npm run e2e -w @wallet/e2e --",
    "e2e:flows": "npm run e2e:flows -w @wallet/e2e --",
    "e2e:sweep": "npm run e2e:sweep -w @wallet/e2e --",
    "format": "prettier --write .",
    "db:generate": "npm run db:generate -w @wallet/backend --",
    "db:migrate": "npm run db:migrate -w @wallet/backend"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "prettier": "^3.8.1"
  }
}
